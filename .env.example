# VANET project — environment variables
# Copy this file to .env (which is gitignored) and fill in real values.
# NEVER commit .env or paste your API key into chat / docs / screenshots.
#
#   cp .env.example .env
#   $EDITOR .env

# REQUIRED — Google Maps API key.
# Get one from https://console.cloud.google.com → APIs & Services → Credentials.
# Enable these APIs on the same project:
#   - Directions API
#   - Distance Matrix API
#   - Roads API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OPTIONAL — how often to poll Google Maps for live traffic (seconds).
# Lower = fresher data, higher API cost / quota burn. Default: 45.
MAPS_REFRESH_SEC=45

# OPTIONAL — random seed for reproducible vehicle generation. Default: 42.
# Fixed seed = same 10 vehicles in the same places every demo run.
SIM_SEED=42
