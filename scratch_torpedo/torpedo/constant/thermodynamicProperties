FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermodynamicProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

barotropicCompressibilityModel  linear;

// ------------- LIQUID (Seawater @ 25 degC) ------------- //
rholSat     rholSat [1 -3  0 0 0 0 0]  1025;      // density [kg/m3]
psil        psil    [0 -2  2 0 0 0 0]  4.4e-7;   // compressibility [s2/m2] = [1/(m/s)^2]

// ------------- VAPOUR (Water vapour) ------------- //
rhovSat     rhovSat [1 -3  0 0 0 0 0]  0.023;     // density [kg/m3]
psiv        psiv    [0 -2  2 0 0 0 0]  2.0e-5;    // compressibility [s2/m2]

// ------------- CAVITATION ------------- //
pSat        pSat    [1 -1 -2 0 0 0 0]  3169;      // vapour pressure @ 25 degC [Pa]

// ------------- SAFETY ------------- //
rhoMin      rhoMin  [1 -3  0 0 0 0 0]  1e-3;

