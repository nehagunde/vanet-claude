FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform  0.3750;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 0.3750;

    }

    outlet
    {
        type zeroGradient;
    }

    upperWall
    {
        type           symmetryPlane;
    }

    lowerWall
    {
        type            symmetryPlane;
    }

    torpedo
    {
        type            kqRWallFunction;
        value           uniform 0.3750;

    }

    frontAndBack
    {
        type            empty;
    }
}

