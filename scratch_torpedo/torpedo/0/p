|  \\    /   O peration     | cavitatingFoam uses ABSOLUTE pressure            |
|   \\  /    A nd           | sigma = (p_out - pSat) / (0.5 rho U^2)          |
|    \\/     M anipulation  | CORRECTED: this is the sigma=0.20 START case    |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// sigma = (p_out - pSat) / (0.5 rho U^2)
// At U=25, rho=1025, pSat=3169: p_out = 3169 + sigma*320312
//   sigma=0.20 -> p_out =  67200 Pa  (THIS FILE - run this first)
//   sigma=0.10 -> p_out =  35200 Pa  (next step, restart from this solution)
//   sigma=0.05 -> p_out =  19200 Pa  (near-full supercavity, final step)
// MUST satisfy p_out > pSat (3169 Pa) otherwise the solver diverges.
// Previous internalField/outlet value of 2000 Pa was BELOW pSat - fixed here.

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 67200;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }

    outlet
    {
        type            fixedValue;
        value           $internalField;
    }

    upperWall
    {
        type            symmetryPlane;
    }

    lowerWall
    {
        type            symmetryPlane;
    }

    torpedo
    {
        type            zeroGradient;


    }

    frontAndBack
    {
        type            empty;
    }
}

