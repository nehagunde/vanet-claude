/*--------------------------------*- C++ -*----------------------------------*\
| =========                 |                                                 |
| \\      /  F ield         | OpenFOAM: The Open Source CFD Toolbox           |
|  \\    /   O peration     | omega = sqrt(k) / (Cmu^0.25 * L), L = 0.07*D     |
|    \\/     M anipulation  | sqrt(0.09375)/(0.5477 * 0.0035) = 159.7 1/s      |
|                            | (was 319.4, which is the k=0.375/U=50 value)    |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 159.7;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 159.7;
    }

    outlet
    {
        type            zeroGradient;
    }

    upperWall
    {
        type            symmetryPlane;
    }

    lowerWall
    {
        type            symmetryPlane;
    }

    torpedo
    {
        type            omegaWallFunction;
        value           uniform 159.7;
    }

    frontAndBack
    {
        type            empty;
    }
}

// ************************************************************************* //
